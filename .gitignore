# Real environment files may contain credentials. Keep only the safe template.
.env
.env.*
!.env.example

# Local credentials and private keys must never enter version control.
credentials/
secrets/
*.pem
*.key

# Local runtime artifacts and editor/OS metadata.
*.log
.local/
target/
tmp/
.DS_Store

# Development-only SpecDD validator dependencies.
tools/specdd/node_modules/
tools/browser-tests/node_modules/

# Personal handoff notes for the local lab; never publish project progress.
STATUS.md

# Vscode 
.vscode/settings.json
